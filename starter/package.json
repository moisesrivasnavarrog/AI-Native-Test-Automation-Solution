{
  "name": "ai-native-starter",
  "version": "1.0.0",
  "description": "Recovery Playwright project for Lab 0 of the AI-Native Test Automation Engineering course.",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:observability": "playwright test tests/observability --project=chromium",
    "typecheck": "tsc --noEmit",
    "show-report": "playwright show-report",
    "observe:import": "node observability/src/cli.ts import",
    "observe:report": "node observability/src/cli.ts report",
    "observe:inspect": "node observability/src/cli.ts inspect"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.6",
    "typescript": "5.9.3"
  }
}
